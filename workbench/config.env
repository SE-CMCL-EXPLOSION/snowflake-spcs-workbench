# =============================================================================
# SPCS Workbench: install settings
# Edit the values below, then run:   ./install.sh
# Lines starting with # are comments. Keep the quotes.
# =============================================================================

# --- 1. Which Snowflake account -----------------------------------------------
# Name of a Snowflake CLI connection (see "snow connection list"). The user must be able to
# use the ACCOUNTADMIN role. Create one with:  snow connection add
SNOW_CONNECTION="default"

# --- 2. Who is the first Workbench admin ---------------------------------------
# Snowflake user name (as in SHOW USERS). Leave empty to use the user of SNOW_CONNECTION.
# Add more admins and users later in the portal: Admin > Users.
FIRST_ADMIN=""

# Existing Snowflake roles whose members should be able to use the Workbench right away
# (space separated, e.g. "ANALYST DATA_SCIENTIST"). Can also be done later in the portal.
USER_ACCESS_ROLES=""

# --- 3. What data sessions can query --------------------------------------------
# Databases users may query from RStudio / Jupyter (space separated). Users still only see
# what their own Snowflake roles allow; this is just the upper limit for the app.
DATA_DATABASES=""

# Optional default database / schema for sf_connect() in sessions (empty = user's defaults)
DEFAULT_DATABASE=""
DEFAULT_SCHEMA=""

# Optional: hosts sessions may reach directly, space separated, e.g. an S3 bucket used by
# R/Python code: "mybucket.s3.us-east-1.amazonaws.com s3.us-east-1.amazonaws.com".
# Don't list package sites (CRAN, PyPI...): packages are approved in the portal instead.
SESSION_EGRESS_HOSTS=""

# --- 4. Names of the objects the installer creates (defaults are fine) -----------
APP_DATABASE="WORKBENCH_APP"        # holds schemas WORKBENCH (app) and SPCS (images)
WAREHOUSE="WORKBENCH_WH"            # created as X-Small if it doesn't exist
OBJECT_PREFIX="WORKBENCH"           # compute pools / integrations: <prefix>_PORTAL_POOL, ...
OWNER_ROLE="WORKBENCH_OWNER"        # role that owns the app
ACCESS_ROLE_PREFIX="WORKBENCH"      # access levels: <prefix>_USER, _AUDITOR, _ADMIN

# --- 5. Size of the session compute pool -----------------------------------------
SESSION_POOL_FAMILY="CPU_X64_M"     # CPU_X64_M fits small/medium/large sessions
SESSION_POOL_MAX_NODES="4"          # max nodes; more nodes = more concurrent sessions

# --- 6. Version -------------------------------------------------------------------
# Image tag. Change it (e.g. v2) and re-run ./install.sh to roll out an updated build.
IMAGE_TAG="v1"
